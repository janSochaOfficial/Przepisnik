{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recipes-list.local/seed/products.schema.json",
  "title": "Seed products (PROJECT §7.2). Upserted by normalized name at startup (insert only when missing).",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "measureKind", "displayClass", "hasSizes", "allowHalf"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "category": {
            "enum": ["vegetables", "fruits", "meat", "fish", "dairy", "bakery", "dryGoods", "spices", "oilsVinegars", "sauces", "canned", "frozen", "drinks", "sweets", "other"]
          },
          "measureKind": { "enum": ["mass", "volume", "count"] },
          "displayClass": { "enum": ["weight", "liquid", "spice", "piece"] },
          "hasSizes": { "type": "boolean" },
          "allowHalf": { "type": "boolean" },
          "gramsPerMl": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "gramsPerPiece": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "defaultPackageAmount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "pieceForms": {
            "oneOf": [
              {
                "type": "object",
                "required": ["one", "few", "many", "fraction"],
                "properties": {
                  "one": { "type": "string" },
                  "few": { "type": "string" },
                  "many": { "type": "string" },
                  "fraction": { "type": "string" }
                },
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "displayClass": { "const": "weight" } } },
            "then": { "properties": { "measureKind": { "const": "mass" } } }
          },
          {
            "if": { "properties": { "displayClass": { "enum": ["liquid", "spice"] } } },
            "then": { "properties": { "measureKind": { "const": "volume" } } }
          },
          {
            "if": { "properties": { "displayClass": { "const": "piece" } } },
            "then": { "properties": { "measureKind": { "const": "count" } } }
          },
          {
            "if": { "properties": { "measureKind": { "enum": ["mass", "volume"] } } },
            "then": { "properties": { "hasSizes": { "const": false }, "allowHalf": { "const": false } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
