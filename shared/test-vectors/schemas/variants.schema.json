{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recipes-list.local/test-vectors/variants.schema.json",
  "title": "variants/<TaskID>.json: base recipe + variant ops → resolved recipes and the variant matrix",
  "description": "Asserted by the backend VariantEngine (resolve, matrix, and diff when 'edited' is given); expectedMatrix is in the API VariantMatrix shape (API.md §5.1) and feeds the frontend matching tests. Ops use the stored shape: the API op plus the server-computed baseAmount on modify/add. Option keys are '<productId>:<baseAmount>' with the amount rounded to 3 decimals in invariant format without trailing zeros ('…:27.3', '…:200'), or ':x' when the amount is null, or 'none'. Variant columns are ordered base first, then the variants in the given order; options are in first-seen order over that column order. isFavorite is always false in vectors.",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "base", "variants", "expectedResolved", "expectedMatrix"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/caseId" },
          "description": { "type": "string" },
          "base": { "$ref": "#/$defs/base" },
          "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
          "edited": {
            "description": "Optional: variant id → the full edited copy (VariantWrite.recipe shape) for diff tests.",
            "type": "object",
            "additionalProperties": { "type": "object" }
          },
          "expectedResolved": {
            "description": "Variant id → the resolved recipe.",
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/resolved" }
          },
          "expectedMatrix": { "$ref": "#/$defs/matrix" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": { "$ref": "common.schema.json#/$defs/uuid" },
    "userRef": {
      "type": "object",
      "required": ["id", "nickname"],
      "properties": { "id": { "$ref": "#/$defs/uuid" }, "nickname": { "type": "string" } },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "name", "category", "measureKind", "displayClass", "hasSizes", "allowHalf", "gramsPerMl", "gramsPerPiece", "defaultPackageAmount", "pieceForms"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "measureKind": { "$ref": "common.schema.json#/$defs/measureKind" },
        "displayClass": { "$ref": "common.schema.json#/$defs/displayClass" },
        "hasSizes": { "type": "boolean" },
        "allowHalf": { "type": "boolean" },
        "gramsPerMl": { "type": ["number", "null"] },
        "gramsPerPiece": { "type": ["number", "null"] },
        "defaultPackageAmount": { "type": ["number", "null"] },
        "pieceForms": { "oneOf": [{ "$ref": "common.schema.json#/$defs/pluralForms" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "quantityOrNull": { "oneOf": [{ "$ref": "common.schema.json#/$defs/quantity" }, { "type": "null" }] },
    "ingredient": {
      "type": "object",
      "required": ["id", "product", "quantity", "baseAmount", "note", "optional"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "product": { "$ref": "#/$defs/product" },
        "quantity": { "$ref": "#/$defs/quantityOrNull" },
        "baseAmount": { "type": ["number", "null"] },
        "note": { "type": ["string", "null"] },
        "optional": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "imageId"],
          "properties": {
            "type": { "const": "image" },
            "imageId": { "$ref": "#/$defs/uuid" },
            "caption": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": ["recipeId", "title", "author", "cookCount", "createdAt", "prepMinutes", "cookMinutes", "utensilIds", "ingredients", "prepSteps", "instructionSteps"],
      "properties": {
        "recipeId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string" },
        "author": { "$ref": "#/$defs/userRef" },
        "cookCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string" },
        "prepMinutes": { "type": ["integer", "null"] },
        "cookMinutes": { "type": ["integer", "null"] },
        "utensilIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "prepSteps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "instructionSteps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "additionalProperties": false
    },
    "ingredientOp": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "targetId", "productId", "quantity", "baseAmount", "note", "optional"],
          "properties": {
            "op": { "const": "modify" },
            "targetId": { "$ref": "#/$defs/uuid" },
            "productId": { "$ref": "#/$defs/uuid" },
            "quantity": { "$ref": "#/$defs/quantityOrNull" },
            "baseAmount": { "type": ["number", "null"] },
            "note": { "type": ["string", "null"] },
            "optional": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "targetId"],
          "properties": { "op": { "const": "remove" }, "targetId": { "$ref": "#/$defs/uuid" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "id", "afterId", "productId", "quantity", "baseAmount", "note", "optional"],
          "properties": {
            "op": { "const": "add" },
            "id": { "$ref": "#/$defs/uuid" },
            "afterId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "productId": { "$ref": "#/$defs/uuid" },
            "quantity": { "$ref": "#/$defs/quantityOrNull" },
            "baseAmount": { "type": ["number", "null"] },
            "note": { "type": ["string", "null"] },
            "optional": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "stepOp": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "section", "targetId", "blocks"],
          "properties": {
            "op": { "const": "replace" },
            "section": { "enum": ["prep", "instructions"] },
            "targetId": { "$ref": "#/$defs/uuid" },
            "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "section", "targetId"],
          "properties": {
            "op": { "const": "remove" },
            "section": { "enum": ["prep", "instructions"] },
            "targetId": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "section", "id", "afterId", "blocks"],
          "properties": {
            "op": { "const": "add" },
            "section": { "enum": ["prep", "instructions"] },
            "id": { "$ref": "#/$defs/uuid" },
            "afterId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
            "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "variant": {
      "type": "object",
      "required": ["id", "name", "author", "cookCount", "createdAt", "ingredientOps", "stepOps", "utensilIdsAdded", "utensilIdsRemoved", "prepMinutes", "cookMinutes"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string" },
        "author": { "$ref": "#/$defs/userRef" },
        "cookCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string" },
        "ingredientOps": { "type": "array", "items": { "$ref": "#/$defs/ingredientOp" } },
        "stepOps": { "type": "array", "items": { "$ref": "#/$defs/stepOp" } },
        "utensilIdsAdded": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "utensilIdsRemoved": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "prepMinutes": { "type": ["integer", "null"] },
        "cookMinutes": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "resolved": {
      "type": "object",
      "required": ["ingredients", "prepSteps", "instructionSteps", "utensilIds", "prepMinutes", "cookMinutes"],
      "properties": {
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "prepSteps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "instructionSteps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "utensilIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "prepMinutes": { "type": ["integer", "null"] },
        "cookMinutes": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "variantRefId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "const": "base" }] },
    "matrix": {
      "type": "object",
      "required": ["recipeId", "variants", "slots"],
      "properties": {
        "recipeId": { "$ref": "#/$defs/uuid" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "author", "cookCount", "createdAt", "isFavorite", "productSwaps"],
            "properties": {
              "id": { "$ref": "#/$defs/variantRefId" },
              "name": { "type": "string" },
              "author": { "$ref": "#/$defs/userRef" },
              "cookCount": { "type": "integer" },
              "createdAt": { "type": "string" },
              "isFavorite": { "type": "boolean" },
              "productSwaps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["fromProductId", "toProductId"],
                  "properties": {
                    "fromProductId": { "$ref": "#/$defs/uuid" },
                    "toProductId": { "$ref": "#/$defs/uuid" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "options"],
            "properties": {
              "key": { "type": "string", "pattern": "^(i|p):" },
              "label": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["key", "ingredient", "variantIds"],
                  "properties": {
                    "key": { "type": "string" },
                    "ingredient": { "oneOf": [{ "$ref": "#/$defs/ingredient" }, { "type": "null" }] },
                    "variantIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/variantRefId" } }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
