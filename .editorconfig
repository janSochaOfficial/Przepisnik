root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,mjs,cjs,svelte,css,html}]
indent_style = tab
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.sh]
indent_size = 2
