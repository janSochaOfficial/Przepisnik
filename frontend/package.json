{
	"name": "recipes-list-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:integration": "playwright test",
		"test:e2e": "playwright test -c playwright.e2e.config.ts",
		"gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
		"lint:api": "redocly lint ../docs/api/openapi.yaml --config ../docs/api/redocly.yaml",
		"validate:shared": "node scripts/validate-shared.mjs",
		"autofix:svelte": "node scripts/svelte-autofix.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource-variable/literata": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.61.0",
		"@playwright/test": "1.64.1",
		"@redocly/cli": "2.71.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"bits-ui": "2.20.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"openapi-fetch": "0.17.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"yaml": "2.9.1"
	}
}
