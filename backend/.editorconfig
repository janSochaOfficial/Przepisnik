# C# conventions (TECHNICAL §7). Enforced by the build (EnforceCodeStyleInBuild) and `dotnet format --verify-no-changes`.
# Deliberate deviations from the analyzer defaults are listed here with a reason.

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 140

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# var when the type is obvious
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-level preferences
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_readonly_field = true:warning
csharp_style_unused_value_discard_variable = true:suggestion

# Naming: private fields _camelCase, constants PascalCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# IDE0005 (unnecessary usings) is reported by the build when documentation generation is on.
dotnet_diagnostic.IDE0005.severity = warning

# CA1716: identifiers like "Unit" / "Optional" are domain words of the contract.
dotnet_diagnostic.CA1716.severity = none
# CA1515: the composition root and the tests need public types (WebApplicationFactory<Program>, xUnit).
dotnet_diagnostic.CA1515.severity = none
# CA1720: "Guid"-like identifiers in DTOs mirror the API contract.
dotnet_diagnostic.CA1720.severity = none
# CA1002/CA2227: EF Core entities expose List<T> navigations/collections with setters on purpose.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0005.severity = none

# Tests: Method_Scenario_ExpectedResult names (TECHNICAL §6) and ConfigureAwait-free async.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2234.severity = none
