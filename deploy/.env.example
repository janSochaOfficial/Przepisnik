# Every configuration variable of RecipesList (TECHNICAL §3.8). Export them for `dotnet run`, or copy this file to
# deploy/.env for Docker Compose (compose.yaml reads only the variables it names; see deploy/README.md).
# Never commit real secrets.

# --- Ports (plan §4.3). Task agents put these in the worktree's .env.local (slot n: 5100+n / 5200+n / 5300+n).
API_PORT=5080
WEB_PORT=5173
PREVIEW_PORT=4173

# --- API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=recipes;Username=recipes;Password=recipes
# Apply EF migrations at startup (default true in Development and Docker).
Database__MigrateOnStartup=true
# Google OAuth web client id. Empty in Development => the login page shows the dev-login form.
Auth__Google__ClientId=
# Users with these emails get the admin flag on login.
Admin__Emails__0=
# Where uploaded images are stored (a Docker volume in production).
Storage__ImagesPath=data/images
# Load shared/seed/*.json at startup (idempotent).
Seed__Enabled=true
# Rate limits per minute (TECHNICAL §3.5).
RateLimiting__AuthPerMinute=10
RateLimiting__ImagesPerMinute=30
RateLimiting__ImportPerMinute=10

# --- Database container (compose.dev.yaml and compose.yaml)
# Host port of the dev database (compose.dev.yaml); change it if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
POSTGRES_USER=recipes
# Change it before the first start on a server.
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes

# --- Docker Compose full stack (compose.yaml). The API always runs as Production there; besides these it reads
# Auth__Google__ClientId, Admin__Emails__0, Seed__Enabled and RateLimiting__* from above.
# Host port Caddy is published on (plain http).
HTTP_PORT=8080
# ":8080" serves http on HTTP_PORT; a domain name (przepisy.example.com) turns on automatic HTTPS on 80/443.
SITE_ADDRESS=:8080
