# Every configuration variable of RecipesList (TECHNICAL §3.8). Copy to deploy/.env for Docker Compose,
# or export them for `dotnet run`. Never commit real secrets.

# --- Ports (plan §4.3). Task agents put these in the worktree's .env.local (slot n: 5100+n / 5200+n / 5300+n).
API_PORT=5080
WEB_PORT=5173
PREVIEW_PORT=4173

# --- API
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=recipes;Username=recipes;Password=recipes
# Apply EF migrations at startup (default true in Development and Docker).
Database__MigrateOnStartup=true
# Google OAuth web client id. Empty in Development => the login page shows the dev-login form.
Auth__Google__ClientId=
# Users with these emails get the admin flag on login.
Admin__Emails__0=
# Where uploaded images are stored (a Docker volume in production).
Storage__ImagesPath=data/images
# Load shared/seed/*.json at startup (idempotent).
Seed__Enabled=true
# Rate limits per minute (TECHNICAL §3.5).
RateLimiting__AuthPerMinute=10
RateLimiting__ImagesPerMinute=30
RateLimiting__ImportPerMinute=10

# --- Database container (compose)
# Host port of the dev database (compose.dev.yaml); change it if a local PostgreSQL already uses 5432.
POSTGRES_PORT=5432
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes
